NODE_ENV=development
PORT=3000

# --- Base de datos (MySQL) ---
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salinas_booking
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=-05:00
# Solo desarrollo: crea tablas faltantes al arrancar. En producción usa `npm run db:migrate`.
DB_SYNC=false

# --- Seguridad ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE=8h
FRONTEND_URL=http://localhost:8100
FRONTEND_URL_2=
TRUST_PROXY=1

# --- Negocio ---
APP_NAME=Salinas Booking
IVA_PORCENTAJE=15
RETENCION_MINUTOS=30

# --- Seed (opcional) ---
SEED_ADMIN_EMAIL=admin@salinasbooking.local
SEED_ADMIN_PASSWORD=

# --- Canal SiteMinder / Little Hotelier (opcional) ---
# Credenciales que SiteMinder usa al llamar a ESTA plataforma (WS-Security). Mínimo 12 caracteres con mayúsculas, minúsculas, números y símbolo.
SITEMINDER_USER=
SITEMINDER_PASSWORD=
# Para enviar reservas a SiteMinder (te las entrega SiteMinder al firmar el acuerdo de socio)
SITEMINDER_RES_URL=https://tpi-cm-siteconn.preprod.siteminderlabs.com/reservation-gateway/services
SITEMINDER_OUT_USER=
SITEMINDER_OUT_PASSWORD=
SITEMINDER_CHANNEL_CODE=
